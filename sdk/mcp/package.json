{
  "name": "sigda-mcp",
  "version": "0.13.0",
  "description": "SIGDA Model Context Protocol server. Drop into Claude Desktop, Cursor, Windsurf, or any MCP-compatible client and your AI tool gets a wallet on SIGDA plus working tools for MiroShark. Cross-platform agent messaging, zero code.",
  "type": "module",
  "bin": {
    "sigda-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
